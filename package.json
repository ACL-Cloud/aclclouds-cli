{
  "name": "aclclouds",
  "version": "0.1.2",
  "description": "Official ACLClouds CLI and local MCP server: manage, deploy and debug your game servers, Discord bots and VPS from the terminal or an AI assistant.",
  "keywords": ["aclclouds", "cli", "mcp", "model-context-protocol", "game-server", "discord-bot", "vps", "deploy"],
  "homepage": "https://aclclouds.com",
  "repository": { "type": "git", "url": "git+https://github.com/ACL-Cloud/aclclouds-cli.git" },
  "bugs": { "url": "https://github.com/ACL-Cloud/aclclouds-cli/issues" },
  "license": "MIT",
  "author": "ACLClouds",
  "type": "module",
  "bin": { "aclclouds": "dist/index.js" },
  "main": "dist/index.js",
  "files": ["dist", "README.md", "LICENSE"],
  "engines": { "node": ">=18" },
  "publishConfig": { "access": "public" },
  "scripts": {
    "build": "rm -rf dist && bun build src/index.ts --target=node --minify --format=esm --outfile=dist/index.js && chmod +x dist/index.js",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "test": "bun test",
    "check": "npm run typecheck && npm run test && npm run build",
    "prepublishOnly": "npm run check"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@types/bun": "^1.3.0",
    "@types/node": "^20.19.43",
    "commander": "^13.1.0",
    "ignore": "^7.0.13",
    "picocolors": "^1.1.1",
    "tar": "^7.5.22",
    "typescript": "~5.9.3",
    "zod": "^3.25.76"
  }
}
